    },
    "Applies to future captures, for Photos and sharing. Higher resolutions can increase assembly time and file size. The result depends on source images and iPhone memory, without upscaling." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux prochaines prises de vue, pour Photos et le partage. Une résolution plus élevée peut allonger l’assemblage et augmenter la taille du fichier. Le résultat dépend des images source et de la mémoire de l’iPhone, sans agrandissement artificiel."
          }
        }
      }
    },
    "Assembly was cancelled." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assemblage a été annulé."
          }
        }
